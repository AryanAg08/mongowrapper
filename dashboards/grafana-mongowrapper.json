            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Database time by collection",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 31
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "topk(10, sum by (database, collection) (rate(mongowrapper_command_duration_seconds_sum{job=~\"$job\", instance=~\"$instance\", database=~\"$database\", command!=\"ping\", collection!=\"-\", collection!=\"\"}[5m])))",
          "range": true,
          "instant": false,
          "refId": "A",
          "legendFormat": "{{database}}/{{collection}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Seconds of database time accrued per second. Ranks by total cost rather than per-query cost, so a fast query run constantly outranks a slow one run hourly — start here when deciding what to index."
    },

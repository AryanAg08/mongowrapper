          "editorMode": "code",
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, database, collection) (rate(mongowrapper_command_duration_seconds_bucket{job=~\"$job\", instance=~\"$instance\", database=~\"$database\", command!=\"ping\", collection!=\"-\", collection!=\"\"}[5m]))))",
          "range": true,

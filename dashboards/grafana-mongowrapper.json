          "editorMode": "code",
          "expr": "sum by (instance) (mongowrapper_pool_connections_in_use{job=~\"$job\", instance=~\"$instance\"})",
          "range": true,
          "instant": false,
          "refId": "B",
          "legendFormat": "in use {{instance}}"
